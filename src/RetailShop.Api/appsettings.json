{
  "ConnectionStrings": {
    "RetailShopDatabase": "Host=localhost;Port=5432;Database=khanshop;Username=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "KhanShop",
    "Audience": "KhanShop.Web",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Database": {
    "InitialiseOnStartup": false
  },
  "DataProtection": {
    "KeysPath": ".keys"
  },
  "MediaStorage": {
    "RootPath": "C:\\BShopData\\Media"
  },
  "BusinessTimeZone": {
    "Id": "Asia/Dhaka"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
